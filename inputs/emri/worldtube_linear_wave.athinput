# Fixed-grid SRMHD linear-wave input for mode-resolved worldtube validation.

<comment>
problem = seven-wave SRMHD outer-to-inner worldtube closure

<job>
basename = emri_worldtube_linear_wave

<mesh>
nghost = 4
nx1    = 64
x1min  = -1.0
x1max  =  1.0
ix1_bc = periodic
ox1_bc = periodic

nx2    = 32
x2min  = -0.5
x2max  =  0.5
ix2_bc = periodic
ox2_bc = periodic

nx3    = 32
x3min  = -0.5
x3max  =  0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement       = none
num_levels       = 1
max_nmb_per_rank = 64

<coord>
special_rel = true
general_rel = false
minkowski   = true

<time>
evolution  = dynamic
integrator = rk3
cfl_number = 0.3
nlim       = -1
tlim       = 0.25
ndiag      = 10

<mhd>
eos         = ideal
reconstruct = plm
rsolver     = hlle
gamma       = 1.3333333333333333
dfloor      = 1.0e-12
tfloor      = 1.0e-12

<problem>
pgen_name = linear_wave
wave_flag = 6
amp       = 1.0e-5
wavelength = 2.0
dens      = 4.0
pgas      = 1.0
vx0       = -0.1
vy0       = 0.3
vz0       = -0.05
bx0       = 2.5
by0       = 1.8
bz0       = -1.2
along_x1  = true
along_x2  = false
along_x3  = false

<emri_worldtube>
enabled        = false
mode           = outer
center_x1      = 0.0
center_x2      = 0.0
center_x3      = 0.0
half_width     = 0.25
dcycle         = 1
overwrite      = false
file_basename  = emri_worldtube_linear_wave.outer
file           =
time_offset    = auto
flux_tolerance = 1.0e-10
fluid_boundary = off
characteristic_speed_tolerance = 1.0e-10

<output1>
file_type = bin
variable  = mhd_w_bcc
dt        = 0.25

<output2>
file_type = bin
variable  = mhd_divb
dt        = 0.25

<output3>
file_type = hst
dt        = 0

<output4>
file_type = rst
dt        = 0
