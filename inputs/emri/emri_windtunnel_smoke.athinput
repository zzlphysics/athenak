# AthenaK smoke input for a local, secondary-centered EMRI GRMHD wind tunnel.
# Lengths are in units with G=c=1.  Here m_secondary=1 and M_primary=1000.

<comment>
problem   = local EMRI wind tunnel
geometry  = circular equatorial orbit; aligned spins; helically symmetric metric

<job>
basename = emri_windtunnel_smoke

<mesh>
nghost = 4
nx1    = 16
x1min  = -8.0
x1max  =  8.0
ix1_bc = user
ox1_bc = outflow

nx2    = 16
x2min  = -8.0
x2max  =  8.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 16
x3min  = -8.0
x3max  =  8.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement         = none
num_levels         = 1
max_nmb_per_rank   = 16
ncycle_check       = 1
refinement_interval = 1
prolong_primitives = false

<amr_criterion0>
method = user

# Optional static-refinement region used by the global-snapshot extraction
# regression.  It is inactive for the default refinement=none smoke run.
<refined_region1>
level = 1
x1min = -4.0
x1max =  4.0
x2min = -4.0
x2max =  4.0
x3min = -4.0
x3max =  4.0

<time>
evolution  = dynamic
integrator = rk2
subcycling = none
cfl_number = 0.15
# Positive synchronized-step ceiling; the GR worldtube closure campaign overrides it.
root_dt_max = 0.05
nlim       = 2
tlim       = 0.05
ndiag      = 1

<coord>
minkowski       = false
excise          = true
excision_scheme = lapse
excise_lapse    = 0.25
dexcise         = 1.0e-8
pexcise         = 1.0e-10

<adm>
# The helically symmetric metric is stationary in the local chart.  Set true for
# time-dependent profile replay or strict level subcycling; ordinary AMR can leave false.
dynamic = false

<mhd>
eos             = ideal
dyn_eos         = ideal
dyn_error       = reset_floor
gamma           = 1.3333333333333333
reconstruct     = plm
rsolver         = hlle
dfloor          = 1.0e-8
tfloor          = 1.0e-8
dthreshold      = 1.01
dyn_scratch     = 1
fofc            = true
enforce_maximum = false

<problem>
pgen_name        = emri_windtunnel
user_hist        = true

# Effective spacetime.  background_mode is full, frame_only, or isolated.
# orbital_radius is the primary Kerr/BL radial coordinate shared by the controls.
background_mode   = full
# Embed the small-hole Kerr perturbation in the primary-background tangent tetrad.
secondary_embedding = tangent_tetrad
primary_mass     = 1000.0
secondary_mass   = 1.0
primary_chi      = 0.5
secondary_chi    = 0.0
orbital_radius   = 10000.0
orbit_direction  = 1
omega_mode       = kerr_geodesic
require_stable_orbit = true

# With wind_frame=source_tetrad, u1,u2,u3 denote physical spatial four-velocity
# components in the secondary-comoving external-background tetrad at the box origin.
# The legacy normal_frame option instead interprets them as GRMHD primitive components.
wind_frame        = source_tetrad
force_frame       = source_tetrad
rho0              = 1.0
pgas0             = 1.0e-2
u1                = 0.5
u2                = 0.0
u3                = 0.0
b1                = 0.0
b2                = 0.0
b3                = 1.0e-2

# Analytic source-tetrad profile.  xh1,xh2,xh3 are radial, prograde tangential,
# and vertical.  Scalars use logarithmic gradients; du_i/dxh_j acts on the
# source-frame spatial four-velocity.  The magnetic-flux gradient must be trace-free;
# when db3_dxh3 is omitted its default is -db1_dxh1-db2_dxh2.
dlnrho_dxh1       = 0.0
dlnrho_dxh2       = 0.0
dlnrho_dxh3       = 0.0
dlnpgas_dxh1      = 0.0
dlnpgas_dxh2      = 0.0
dlnpgas_dxh3      = 0.0
du1_dxh1          = 0.0
du1_dxh2          = 0.0
du1_dxh3          = 0.0
du2_dxh1          = 0.0
du2_dxh2          = 0.0
du2_dxh3          = 0.0
du3_dxh1          = 0.0
du3_dxh2          = 0.0
du3_dxh3          = 0.0
db1_dxh1          = 0.0
db1_dxh2          = 0.0
db1_dxh3          = 0.0
db2_dxh1          = 0.0
db2_dxh2          = 0.0
db2_dxh3          = 0.0
db3_dxh1          = 0.0
db3_dxh2          = 0.0
db3_dxh3          = 0.0
max_log_contrast  = 20.0

# Optional time-dependent Taylor replay.  A nonempty table requires adm/dynamic=true.
profile_file          =
profile_time_offset   = auto
profile_extrapolation = error

# Metric regularization is compactly supported inside the component horizons.
spin_buffer_primary   = 0.05
spin_buffer_secondary = 0.05
singularity_floor     = 1.0e-3
metric_fd_step        = 5.0e-5

# Force diagnostics.  Fmom is measured on the inner sphere; Frel1..3 are the
# relativistic secondary-source forces accumulated from that sphere to each outer radius.
force_surface_radius    = 3.0
force_outer_radius_1    = 4.0
force_outer_radius_2    = 6.0
force_outer_radius_3    = 7.5
force_surface_nlevel    = 5
force_subtract_background = true

<emri_worldtube>
# Optional fixed, grid-aligned outer extractor.  It is disabled in the ordinary smoke
# run; the end-to-end writer test enables it from the command line.
enabled       = false
mode          = outer
center_x1     = 0.0
center_x2     = 0.0
center_x3     = 0.0
half_width    = 4.0
dcycle        = 1
overwrite     = false
file_basename = emri_windtunnel_smoke.outer_worldtube
file          =
time_offset   = auto
flux_tolerance = 1.0e-10
# off: magnetic CT replay only; riemann: time-interpolated exterior fluid ghost state
# consumed by the ordinary GRMHD boundary Riemann solver (requires trailing bcc state).
# characteristic_gr additionally requires fluid_state_frame=inner_coordinate after the
# source data have actually been mapped into this simulation's coordinate components.
fluid_boundary = off
fluid_state_frame = unverified

<emri_adm_replay>
# Optional numerical-background plus analytic-secondary volume metric.  The inner
# worldtube constructor replaces the analytic prescribed-ADM callback when enabled.
enabled = false
file = emri_adm_volume.bin

<output1>
file_type = bin
variable  = mhd_w
dt        = 0.05

<output2>
file_type = bin
variable  = adm
dt        = 0.05

<output3>
file_type = rst
dt        = 0.05

<output4>
file_type      = hst
dt             = 0.025
user_hist_only = true

<output5>
# Disabled unless the numerical-ADM replay pilot requests an endpoint audit.
file_type = bin
variable  = adm
dt        = 0.0
