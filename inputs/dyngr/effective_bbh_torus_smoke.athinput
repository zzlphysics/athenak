# LOW-RESOLUTION SOFTWARE SMOKE TEST ONLY.
#
# This mesh is intentionally too coarse for horizon, MRI, magnetic-flux, accretion-rate,
# or turbulence measurements.  It exists to exercise the reference Fishbone-Moncrief
# torus initial data, single-loop vector potential, CT curl, one SMR interface, and strict
# 2:1 level subcycling.  Do not cite results from this input as a scientific simulation.

<comment>
problem   = compact reference torus in an effective binary-black-hole spacetime
reference = Fishbone and Moncrief 1976; Combi and Ressler arXiv:2403.13308

<job>
basename = effective_bbh_torus_smoke

<mesh>
nghost = 4
nx1    = 64
x1min  = -80.0
x1max  =  80.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 64
x2min  = -80.0
x2max  =  80.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 64
x3min  = -80.0
x3max  =  80.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement         = static
max_nmb_per_rank   = 160
prolong_primitives = false

# The root spacing is 2.5M; this box gives 1.25M spacing across the inner edge and
# density maximum.  That is sufficient to see the torus, but far below scientific
# resolution.  The outer boundary lies beyond the reference torus's roughly 64.4M edge.
<refined_region1>
level = 1
x1min = -40.0
x1max =  40.0
x2min = -40.0
x2max =  40.0
x3min = -40.0
x3max =  40.0

<time>
evolution  = dynamic
integrator = rk2
subcycling = level
cfl_number = 0.2
nlim       = 2
tlim       = 100.0
ndiag      = 1

<coord>
minkowski       = false
excise          = true
excision_scheme = lapse
excise_lapse    = 0.25
dexcise         = 1.0e-10
pexcise         = 3.333333333333e-13

<adm>
dynamic = true

<mhd>
eos             = ideal
dyn_eos         = ideal
dyn_error       = reset_floor
gamma           = 1.3333333333333333
reconstruct     = plm
rsolver         = hlle
dfloor          = 1.0e-10
tfloor          = 3.333333333333e-13
dthreshold      = 1.01
dyn_scratch     = 1
fofc            = true
enforce_maximum = false

<problem>
pgen_name              = dynbbh
trajectory_mode        = circular
trajectory_file        = none
trajectory_time_offset = 0.0
separation             = 20.0
mass_ratio             = 1.0
omega                  = 0.01118033988749895
chi1                   = 0.0
chi2                   = 0.0
theta1                 = 0.0
theta2                 = 0.0
phi1                   = 0.0
phi2                   = 0.0
mass_scale1            = 1.0
mass_scale2            = 1.0
spin_buffer1           = 0.05
spin_buffer2           = 0.05
singularity_floor      = 1.0e-3
amr_condition          = track
alpha_threshold        = 0.6
refinement_radius      = 6.0
history_inner_radius   = 80.0
user_hist              = true

initial_data              = reference_fm_torus
torus_reference_mass      = 1.0
torus_reference_center1   = 0.0
torus_reference_center2   = 0.0
torus_reference_center3   = 0.0
torus_reference_velocity1 = 0.0
torus_reference_velocity2 = 0.0
torus_reference_velocity3 = 0.0
torus_r_edge              = 18.0
torus_r_peak              = 29.0
torus_rho_max             = 1.0
torus_rho_min             = 1.0e-5
torus_rho_pow             = -1.5
torus_pgas_min            = 3.333333333333e-8
torus_pgas_pow            = -2.5
torus_rho_atm             = 1.0e-10
torus_temp_atm            = 3.333333333333e-13
torus_pert_amp            = 0.02
torus_seed                = 1
torus_magnetic_field      = single_loop
torus_potential_cutoff    = 0.2
torus_mag_norm            = density_weighted_beta
torus_mag_target          = 100.0
torus_min_grid_peak_fraction = 0.9
torus_min_magnetic_cells  = 64
torus_require_full_domain = true

<output1>
file_type   = hst
data_format = %.17e
dcycle      = 1

<output2>
file_type   = bin
variable    = mhd_w_bcc
dcycle      = 1
ghost_zones = false

<output3>
file_type   = bin
variable    = mhd_divb
dcycle      = 1
ghost_zones = false

<output4>
file_type = rst
dcycle    = 2

<output5>
file_type = log
dcycle    = 1

<output6>
file_type            = bin
variable             = mhd_w_bcc
id                   = bbh_local_w
dcycle               = 1
region_center         = bbh_com
region_half_width     = 40.0
region_slice_axis     = 3
region_slice_offset   = 0.0
ghost_zones           = false
