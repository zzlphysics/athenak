# Small 3D dynamic-BBH stable-AMR problem for strict restart equivalence.
# Cycle 1 refines the central root block around the two tracked holes; their motion over
# six 1e-3 root steps is deliberately too small to change that hierarchy.  The strongly
# magnetized uniform atmosphere makes a stale synchronized ghost/primitive cache affect
# subsequent active conserved cells without requiring a full torus setup.

<job>
basename = subcycling_stable_amr_restart_dyngrmhd

<mesh>
nghost = 4
nx1    = 12
x1min  = -12.0
x1max  =  12.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 4
x2min  = -4.0
x2max  =  4.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 4
x3min  = -4.0
x3max  =  4.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 4
nx2 = 4
nx3 = 4

<mesh_refinement>
refinement          = adaptive
max_nmb_per_rank    = 16
num_levels          = 2
ncycle_check        = 1
refinement_interval = 1
prolong_primitives  = false

<amr_criterion0>
method = user

<time>
evolution  = dynamic
integrator = rk2
subcycling = level
allow_legacy_subcycling_restart = false
cfl_number = 0.2
root_dt_max = 1.0e-3
nlim       = 6
tlim       = 0.1
ndiag      = 1

<coord>
minkowski       = false
excise          = true
excision_scheme = lapse
excise_lapse    = 0.25
dexcise         = 1.0e-8
pexcise         = 1.0e-10

<adm>
dynamic = true

<mhd>
eos             = ideal
dyn_eos         = ideal
dyn_error       = reset_floor
gamma           = 1.3333333333333333
reconstruct     = plm
rsolver         = hlle
dfloor          = 1.0e-10
tfloor          = 1.0e-8
dthreshold      = 1.01
dyn_scratch     = 1
fofc            = true
enforce_maximum = false

<problem>
pgen_name              = dynbbh
trajectory_mode        = circular
trajectory_file        = none
trajectory_time_offset = 0.0
separation             = 4.0
omega                  = 0.01
mass_ratio             = 1.0
chi1                   = 0.0
chi2                   = 0.0
theta1                 = 0.0
theta2                 = 0.0
phi1                   = 0.0
phi2                   = 0.0
rho0                   = 1.0e-5
pgas0                  = 1.0e-7
u1                     = 0.0
u2                     = 0.0
u3                     = 0.0
b1                     = 0.0
b2                     = 0.0
b3                     = 1.0e-3
mass_scale1            = 0.25
mass_scale2            = 0.25
spin_buffer1           = 0.05
spin_buffer2           = 0.05
singularity_floor      = 1.0e-3
amr_condition          = track
alpha_threshold        = 0.6
refinement_radius      = 1.3
refinement_radius_ratio = 1.0
refinement_hysteresis  = 1.25
refinement_horizon_factor = 1.25
refinement_radius_level_1 = 1.3
# Retained so the same compact input can exercise a third physical level through a
# command-line num_levels override in the restart regression.
refinement_radius_level_2 = 1.3
refinement_floor_radius = 0.0
refinement_floor_level  = 0

# The driver forces an off-cadence final dump, keeping each segment compact while
# exposing active and ghost states at its synchronized endpoint.
<output1>
file_type   = bin
variable    = mhd_u_bcc
dcycle      = 100
ghost_zones = true

<output2>
file_type   = bin
variable    = mhd_w_bcc
dcycle      = 100
ghost_zones = true

<output3>
file_type   = bin
variable    = mhd_divb
dcycle      = 100
ghost_zones = false

<output4>
file_type            = rst
dcycle                = 3
single_file_per_rank  = false
