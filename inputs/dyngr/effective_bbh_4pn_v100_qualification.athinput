# NON-PUBLICATION 8xV100-32G LONG-RUN QUALIFICATION INPUT.
#
# This input deliberately reduces the spatial science resolution while preserving the
# software paths needed to qualify long BBH GRMHD runs: the frozen 4PN-to-remnant
# trajectory, reference Fishbone-Moncrief torus, magnetic loop, dynamic ADM spacetime,
# ten physical AMR levels, moving-hole tracking, strict level-by-level 2:1 subcycling,
# restart, event logging, and global/local diagnostics.  Its output MUST NOT be included
# in the L/M/H convergence sequence or interpreted as publication-quality physics.
#
# Audited external trajectory artifact:
#   file       bbh-dense-single-r7-d12-v3.dat
#   SHA-256    42575c6b6a07f4a4fad22b6fecedbf4719aada11093b91556c46475379a9cac0
#   sidecar    bbh-dense-single-r7-d12-v3.dat.provenance.json
#   sidecar SHA-256
#              64247d4d8b018d48d3d8ba9b4c7048d86418e36ba4923f8fecc48d10b489bf1e
# The fixed trajectory_file below is the retained-cloud-disk deployment path.  Verify
# its content hash before launch; for local parse/topology checks override only that path.
#
# Resource contract (not yet a runtime qualification):
#   8 MPI ranks, one V100-32G per rank, double precision, CUDA-aware MPI
#   max_nmb_per_rank=1024 (conservative model: 14.33 MiB/slot = 14673.9 MiB/GPU)
#   cold-start topology expected at the reference offset: exactly 4320 MeshBlocks
#   8-rank GID partition replay: 351--724 blocks/rank, cost 75683--75792/rank
# A topology mismatch, a rank needing more than 1024 blocks, or a non-double executable
# invalidates the launch.  Do not raise max_nmb_per_rank to evade a capacity failure.

<comment>
problem = NON-PUBLICATION 8xV100 long-run 4PN moving-AMR qualification

<job>
basename = effective_bbh_4pn_V100Q

<mesh>
nghost = 4
nx1 = 64
x1min = -1024
x1max = 1024
ix1_bc = outflow
ox1_bc = outflow
nx2 = 64
x2min = -1024
x2max = 1024
ix2_bc = outflow
ox2_bc = outflow
nx3 = 64
x3min = -1024
x3max = 1024
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement = adaptive
num_levels = 10
max_nmb_per_rank = 1024
ncycle_check = 1
refinement_interval = 1
prolong_primitives = false

<amr_criterion0>
method = user

# Keep essentially the complete reference torus (r_outer=64.4055M) at least on L4.
# Complete MeshBlocks intersecting this cube extend slightly beyond the nominal 64M.
<refined_region1>
level = 4
x1min = -64
x1max = 64
x2min = -64
x2max = 64
x3min = -64
x3max = 64

# Preseed the finest moving-hole targets at the frozen table's reference offset.
<refined_region2>
level = 9
x1min = 8.7430295226041217
x1max = 11.256788839345827
x2min = -1.2142671546310384
x2max = 1.2994921621106668
x3min = -1.2568796583708526
x3max = 1.2568796583708526

<refined_region3>
level = 9
x1min = -11.256788839345827
x1max = -8.7430295226041217
x2min = -1.2994921621106668
x2max = 1.2142671546310384
x3min = -1.2568796583708526
x3max = 1.2568796583708526

# The first runtime regrid occurs only after the first 4.8M root step.  Pre-apply its
# four direct L7->L8 refinements for the t=4.8,7.2,9.6M tracker samples.  MeshBlockTree's
# strict 2:1 neighbor propagation supplies every required coarser shell.
<refined_region4>
level = 8
x1min = -10
x1max = -10
x2min = -6
x2max = -6
x3min = -2
x3max = 2

<refined_region5>
level = 8
x1min = 10
x1max = 10
x2min = 6
x2max = 6
x3min = -2
x3max = 2

# Pre-apply the same regrid's 56 direct L8->L9 refinements.  The ten disjoint boxes are
# an exact cuboid cover of those parent MeshBlocks, not a Cartesian bounding box around
# each spherical shell; the latter would overallocate 4,992 blocks at startup.
<refined_region6>
level = 9
x1min = -13
x1max = -7
x2min = -3
x2max = -3
x3min = -1
x3max = 1

<refined_region7>
level = 9
x1min = 7
x1max = 13
x2min = 3
x2max = 3
x3min = -1
x3max = 1

<refined_region8>
level = 9
x1min = -11
x1max = -9
x2min = -3
x2max = 1
x3min = -3
x3max = -3

<refined_region9>
level = 9
x1min = -11
x1max = -9
x2min = -3
x2max = 1
x3min = 3
x3max = 3

<refined_region10>
level = 9
x1min = 9
x1max = 11
x2min = -1
x2max = 3
x3min = -3
x3max = -3

<refined_region11>
level = 9
x1min = 9
x1max = 11
x2min = -1
x2max = 3
x3min = 3
x3max = 3

<refined_region12>
level = 9
x1min = -13
x1max = -13
x2min = -1
x2max = 1
x3min = -1
x3max = 1

<refined_region13>
level = 9
x1min = -7
x1max = -7
x2min = -1
x2max = 1
x3min = -1
x3max = 1

<refined_region14>
level = 9
x1min = 7
x1max = 7
x2min = -1
x2max = 1
x3min = -1
x3max = 1

<refined_region15>
level = 9
x1min = 13
x1max = 13
x2min = -1
x2max = 1
x3min = -1
x3max = 1

# Complete the t=0,2.4,4.8M startup lookahead at L9.  These two trailing slabs are not
# selected by the first post-step t=4.8,7.2,9.6M window, but are required before that
# first step is taken; retaining both windows avoids a resolution hole at cold start.
<refined_region16>
level = 9
x1min = -11
x1max = -9
x2min = 3
x2max = 3
x3min = -1
x3max = 1

<refined_region17>
level = 9
x1min = 9
x1max = 11
x2min = -3
x2max = -3
x3min = -1
x3max = 1

<time>
evolution = dynamic
integrator = rk2
subcycling = level
cfl_number = 0.3
# Deliberately retain the L campaign's 4.8M synchronization/regrid cadence.  Since this
# qualification root spacing is 32M, the cap is more conservative than its 9.6M CFL limit.
root_dt_max = 4.8
nlim = -1
tlim = 96.0
ndiag = 1

<coord>
minkowski = false
excise = true
excision_scheme = lapse
excise_lapse = 0.25
dexcise = 1.0e-10
pexcise = 3.333333333333e-13

<adm>
dynamic = true

<mhd>
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
gamma = 1.3333333333333333
reconstruct = wenoz
rsolver = hlle
dfloor = 1.0e-10
tfloor = 3.333333333333e-13
dthreshold = 1.01
dyn_scratch = 1
fofc = true
enforce_maximum = false
# Qualification telemetry is intentionally fail-visible: cap detailed per-cell reports
# while retaining exact aggregate counts.  The V100 long-soak baseline limits the
# conserved B^2/D proxy to 100 after the t=96M A/B gate; this is a software-stability
# setting, not a publication floor prescription (which requires a sensitivity sweep).
c2perrs = 8
max_bsq = 100.0

<problem>
pgen_name = dynbbh
trajectory_mode = table
trajectory_file = /data/athenak-l4/assets/bbh-dense-single-r7-d12-v3.dat
trajectory_time_offset = 0.203941322579311
separation = 20.0
mass_ratio = 1.0
chi1 = 0.0
chi2 = 0.0
theta1 = 0.0
theta2 = 0.0
phi1 = 0.0
phi2 = 0.0
metric_fd_step = 5.0000000000000002e-05
mass_scale1 = 1.0
mass_scale2 = 1.0
spin_buffer1 = 0.05
spin_buffer2 = 0.05
singularity_floor = 1.0e-3
amr_condition = track
alpha_threshold = 0.6
refinement_radius = 1.0
refinement_radius_ratio = 2.0
refinement_hysteresis = 1.25
refinement_horizon_factor = 1.25
refinement_radius_level_1 = 12
refinement_radius_level_2 = 12
refinement_radius_level_3 = 12
refinement_radius_level_4 = 12
refinement_radius_level_5 = 12
refinement_radius_level_6 = 8
refinement_radius_level_7 = 4
refinement_radius_level_8 = 2
refinement_radius_level_9 = 1
refinement_floor_radius = 64
refinement_floor_level = 4
refinement_floor_center1 = 0
refinement_floor_center2 = 0
refinement_floor_center3 = 0
history_inner_radius = 64
user_hist = true

initial_data = reference_fm_torus
torus_reference_mass = 1.0
torus_reference_center1 = 0.0
torus_reference_center2 = 0.0
torus_reference_center3 = 0.0
torus_reference_velocity1 = 0.0
torus_reference_velocity2 = 0.0
torus_reference_velocity3 = 0.0
torus_r_edge = 18.0
torus_r_peak = 29.0
torus_rho_max = 1.0
torus_rho_min = 1.0e-5
torus_rho_pow = -1.5
torus_pgas_min = 3.333333333333e-8
torus_pgas_pow = -2.5
torus_rho_atm = 1.0e-10
torus_temp_atm = 3.333333333333e-13
torus_pert_amp = 0.02
torus_seed = 1
torus_magnetic_field = single_loop
torus_potential_cutoff = 0.2
torus_mag_norm = density_weighted_beta
torus_mag_target = 100.0
torus_min_grid_peak_fraction = 0.9
torus_min_magnetic_cells = 64
torus_require_full_domain = true

# Histories and event/floor/C2P/FOFC log are sampled at every synchronized root endpoint.
<output1>
file_type = hst
data_format = %.17e
dcycle = 1

# Low-cadence global three-dimensional primitive/MHD state.
<output2>
file_type = bin
variable = mhd_w_bcc
dt = 48.0
ghost_zones = false

# Global constrained-transport divergence audit.
<output3>
file_type = bin
variable = mhd_divb
dt = 19.2
ghost_zones = false

# Four root steps: intentionally dense while debugging long-run/restart failures.
<output4>
file_type = rst
dt = 19.2

# Native metric-aware GRMHD diagnostics, cadence-matched to output2.
<output5>
file_type = bin
variable = mhd_gr_diagnostics
dt = 48.0
ghost_zones = false

<output6>
file_type = log
dcycle = 1
write_zeros = true

# Dense 80M-wide equatorial planes following the binary center of mass.
<output7>
file_type = bin
variable = mhd_w_bcc
id = bbh_local_w
dcycle = 1
region_center = bbh_com
region_half_width = 40.0
region_slice_axis = 3
region_slice_offset = 0.0
ghost_zones = false

<output8>
file_type = bin
variable = mhd_gr_diagnostics
id = bbh_local_gr
dcycle = 1
region_center = bbh_com
region_half_width = 40.0
region_slice_axis = 3
region_slice_offset = 0.0
ghost_zones = false
