# TWO-A100 NUMERICAL PREFLIGHT -- NOT A SCIENTIFIC PRODUCTION INPUT.
#
# This setup keeps the paper-reference equal-mass, nonspinning binary and Fishbone-
# Moncrief torus parameters, while using four static refinement levels to exercise strict
# 2:1 level subcycling with a realistically imbalanced hierarchy.  The finest spacing is
# dx=M/12.8 in 5M boxes around both holes.  The torus body is much less resolved and the
# circular effective metric is not a PN-to-remnant trajectory, so no physical diagnostic
# from this input is publishable.  Its purpose is GPU memory, performance, restart, CT,
# and short-time stability qualification before a trajectory-backed convergence campaign.

<comment>
problem   = two-A100 paper-parameter BBH torus numerical preflight
reference = Fishbone and Moncrief 1976; Combi and Ressler arXiv:2403.13308

<job>
basename = effective_bbh_torus_a100_preflight

<mesh>
nghost = 4
nx1    = 128
x1min  = -80.0
x1max  =  80.0
ix1_bc = outflow
ox1_bc = outflow

nx2    = 128
x2min  = -80.0
x2max  =  80.0
ix2_bc = outflow
ox2_bc = outflow

nx3    = 128
x3min  = -80.0
x3max  =  80.0
ix3_bc = outflow
ox3_bc = outflow

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<mesh_refinement>
refinement         = static
max_nmb_per_rank   = 800
prolong_primitives = false

# Resolve the torus body one level above the 1.25M root spacing.
<refined_region1>
level = 1
x1min = -40.0
x1max =  40.0
x2min = -40.0
x2max =  40.0
x3min = -40.0
x3max =  40.0

# Successively nested boxes around the holes at x=+/-10M.  At level 4 each box spans
# 5M on a side and has dx=0.078125M, which is finer than the M/8 preflight target.
<refined_region2>
level = 2
x1min = -20.0
x1max =   0.0
x2min = -10.0
x2max =  10.0
x3min = -10.0
x3max =  10.0

<refined_region3>
level = 2
x1min =   0.0
x1max =  20.0
x2min = -10.0
x2max =  10.0
x3min = -10.0
x3max =  10.0

<refined_region4>
level = 3
x1min = -15.0
x1max =  -5.0
x2min =  -5.0
x2max =   5.0
x3min =  -5.0
x3max =   5.0

<refined_region5>
level = 3
x1min =   5.0
x1max =  15.0
x2min =  -5.0
x2max =   5.0
x3min =  -5.0
x3max =   5.0

<refined_region6>
level = 4
x1min = -12.5
x1max =  -7.5
x2min =  -2.5
x2max =   2.5
x3min =  -2.5
x3max =   2.5

<refined_region7>
level = 4
x1min =   7.5
x1max =  12.5
x2min =  -2.5
x2max =   2.5
x3min =  -2.5
x3max =   2.5

<time>
evolution  = dynamic
integrator = rk2
subcycling = level
cfl_number = 0.3
nlim       = 1000
tlim       = 1.0
ndiag      = 1

<coord>
minkowski       = false
excise          = true
excision_scheme = lapse
excise_lapse    = 0.25
dexcise         = 1.0e-10
pexcise         = 3.333333333333e-13

<adm>
dynamic = true

<mhd>
eos             = ideal
dyn_eos         = ideal
dyn_error       = reset_floor
gamma           = 1.3333333333333333
reconstruct     = wenoz
rsolver         = hlle
dfloor          = 1.0e-10
tfloor          = 3.333333333333e-13
dthreshold      = 1.01
dyn_scratch     = 1
fofc            = true
enforce_maximum = false

<problem>
pgen_name              = dynbbh
user_hist              = true
history_inner_radius   = 80.0
trajectory_mode        = circular
trajectory_file        = none
trajectory_time_offset = 0.0
separation             = 20.0
mass_ratio             = 1.0
omega                  = 0.01118033988749895
chi1                   = 0.0
chi2                   = 0.0
theta1                 = 0.0
theta2                 = 0.0
phi1                   = 0.0
phi2                   = 0.0
metric_fd_step         = 5.0e-5
mass_scale1            = 1.0
mass_scale2            = 1.0
spin_buffer1           = 0.05
spin_buffer2           = 0.05
singularity_floor      = 1.0e-3
amr_condition          = track
alpha_threshold        = 0.6
refinement_radius      = 1.0
refinement_radius_ratio = 2.0
refinement_hysteresis  = 1.25

initial_data              = reference_fm_torus
torus_reference_mass      = 1.0
torus_reference_center1   = 0.0
torus_reference_center2   = 0.0
torus_reference_center3   = 0.0
torus_reference_velocity1 = 0.0
torus_reference_velocity2 = 0.0
torus_reference_velocity3 = 0.0
torus_r_edge              = 18.0
torus_r_peak              = 29.0
torus_rho_max             = 1.0
torus_rho_min             = 1.0e-5
torus_rho_pow             = -1.5
torus_pgas_min            = 3.333333333333e-8
torus_pgas_pow             = -2.5
torus_rho_atm             = 1.0e-10
torus_temp_atm            = 3.333333333333e-13
torus_pert_amp             = 0.02
torus_seed                 = 1
torus_magnetic_field      = single_loop
torus_potential_cutoff    = 0.2
torus_mag_norm            = density_weighted_beta
torus_mag_target          = 100.0
torus_min_grid_peak_fraction = 0.95
torus_min_magnetic_cells  = 512
torus_require_full_domain = true

<output1>
file_type   = hst
data_format = %.17e
dcycle      = 1

# A cadence larger than the cycle count writes only initialization and finalization
# endpoints.  Performance runners override all outputs off.
<output2>
file_type   = bin
variable    = mhd_w_bcc
dcycle      = 9999
ghost_zones = false

<output3>
file_type   = bin
variable    = mhd_divb
dcycle      = 9999
ghost_zones = false

<output4>
file_type = rst
dcycle    = 9999

<output5>
file_type = log
dcycle    = 1
