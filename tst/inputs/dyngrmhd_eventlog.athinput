# Small deterministic DynGRMHD problem for event-counter and restart regressions.

<job>
basename = dyngrmhd_eventlog

<mesh>
nghost = 3
nx1 = 8
x1min = -0.5
x1max = 0.5
ix1_bc = periodic
ox1_bc = periodic
nx2 = 1
x2min = -0.5
x2max = 0.5
ix2_bc = periodic
ox2_bc = periodic
nx3 = 1
x3min = -0.5
x3max = 0.5
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 8
nx2 = 1
nx3 = 1

<mesh_refinement>
refinement = none

<coord>
special_rel = false
general_rel = true
minkowski = false
excise = true
excision_scheme = lapse
excise_lapse = 0.25
dexcise = 1.0e-10
pexcise = 1.0e-10

<adm>
dynamic = true

<time>
evolution = dynamic
integrator = rk2
allow_legacy_ghost_event_counters = false
cfl_number = 0.3
nlim = 2
tlim = 100.0
ndiag = 1

<mhd>
eos = ideal
dyn_eos = ideal
dyn_error = reset_floor
gamma = 1.3333333333333333
reconstruct = plm
rsolver = llf
dfloor = 1.0e-10
tfloor = 1.0e-10
c2p_iter = 50
c2perrs = 1
max_bsq = 1.0e6
fofc = true

<problem>
pgen_name = dynbbh
trajectory_mode = circular
separation = 20.0
mass_ratio = 1.0
trajectory_time_offset = 0.0
metric_fd_step = 5.0e-5
amr_condition = alpha_min
initial_data = uniform
rho0 = 1.0e-5
pgas0 = 1.0e-7
b3 = 0.0

<output1>
file_type = log
dcycle = 1
write_zeros = true

<output2>
file_type = rst
dcycle = 1
single_file_per_rank = false

<output3>
file_type = bin
variable = mhd_u_bcc
dcycle = 0
ghost_zones = false
